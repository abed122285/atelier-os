# ATELIER OS — Supabase & PostgreSQL Configuration (Maison AFAF EL ASSLI)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-server-only-service-role-key-never-expose-to-client"
